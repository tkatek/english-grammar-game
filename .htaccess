# Grammar Quest — production caching (Apache).
# GitHub Pages users: this file is ignored there; GH Pages already sends
# far-future cache headers for assets and short headers for HTML.

# HTML must always revalidate so players get updates immediately.
<FilesMatch "\.(html)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# Fingerable-by-content art/audio: long cache, revisit after a deploy.
# Bump ASSET_VERSION in js/loader.js if you swap images in place.
<FilesMatch "\.(webp|png|jpe?g|svg|mp3)$">
  Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
</FilesMatch>

# Code + data: revalidate cheaply (304s) so fixes ship fast.
<FilesMatch "\.(js|css|json)$">
  Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>

# Compression for text payloads.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
